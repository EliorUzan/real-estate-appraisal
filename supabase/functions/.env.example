# Set these as Edge Function secrets, never VITE_* variables.
NADLAN_MCP_URL=https://your-nadlan-host.example/mcp
NADLAN_MCP_TOKEN=replace-with-the-same-random-token-used-by-the-nadlan-host
# New browser collector (a separate container, not the existing MCP endpoint).
NADLAN_BROWSER_URL=https://your-nadlan-browser-host.example/collect
NADLAN_BROWSER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Exact origins, comma-separated. Never use '*' for browser credential onboarding.
CLI_ONBOARDING_ORIGINS=http://127.0.0.1:5175
# Optional owner-managed wake credentials. Keep all values server-side.
CLI_CODESPACE_NAME=refactored-winner-7w5x75jrvjv2wqwv
CLI_CODESPACE_OWNER=EliorUzan
CLI_CODESPACE_REPOSITORY=EliorUzan/real-estate-appraisal
CLI_CODESPACE_GITHUB_TOKEN=
