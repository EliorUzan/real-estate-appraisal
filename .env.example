# Backend (do not commit an actual .env file)
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=server-only-secret-key
DATABASE_POOL_URL=postgresql://app_user:password@host:6543/postgres
CREDENTIAL_ENCRYPTION_KEY_V1=base64-encoded-32-byte-key
CREDENTIAL_ACTIVE_KEY_VERSION=1
STORAGE_BUCKET=temporary-source-files
CRON_SECRET=replace-with-a-random-secret
MOCK_PROVIDERS=true

# Frontend: every VITE_ value is included in the browser bundle.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
