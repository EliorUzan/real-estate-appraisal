CLI_WORKER_URL=https://cdgjvtzxfpguqetpljae.supabase.co/functions/v1/cli-worker
CLI_HOST_ID=REQUIRED_REGISTERED_HOST_UUID
CLI_DATA_DIR=/var/lib/cli-gateway
CLI_MANIFEST_DIR=/etc/cli-gateway/manifests
# Optional; leave absent until the separately reviewed native protocol is approved.
# CLI_LOGIN_MANIFEST_DIR=/etc/cli-gateway/login-manifests
# Optional operator Maps setup; private directory is never mounted into job containers.
# CLI_MAPS_CONFIG_DIR=/var/lib/cli-gateway/maps
# systemd supplies this through LoadCredential; set it explicitly in Codespaces.
CLI_HOST_SECRET_FILE=/etc/cli-gateway/host-secret
DOCKER_HOST=unix:///run/user/REQUIRED_UID/docker.sock
XDG_RUNTIME_DIR=/run/user/REQUIRED_UID
